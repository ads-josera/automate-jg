<?php

declare(strict_types=1);

use Drupal\user\Entity\Role;
use Drupal\aseguramiento_automation\Entity\ConstanciaEntity;
use Drupal\aseguramiento_automation\Mail\EmailTemplateDefaults;

/**
 * Implements hook_install().
 */
function aseguramiento_automation_install(): void {
  aseguramiento_automation_ensure_gestor_role();
  aseguramiento_automation_ensure_email_templates();
}

/**
 * Creates the Gestor Aseguramiento role on existing installations.
 */
function aseguramiento_automation_update_11001(): string {
  aseguramiento_automation_ensure_gestor_role();
  return 'Created or updated the Gestor Aseguramiento role.';
}

/**
 * Adds the full client insurance request fields to constancias.
 */
function aseguramiento_automation_update_11002(): string {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('aseguramiento_constancia');
  $field_definitions = ConstanciaEntity::baseFieldDefinitions($entity_type);

  foreach (aseguramiento_automation_solicitud_field_names() as $field_name) {
    if ($definition_update_manager->getFieldStorageDefinition($field_name, 'aseguramiento_constancia')) {
      continue;
    }
    $definition_update_manager->installFieldStorageDefinition($field_name, 'aseguramiento_constancia', 'aseguramiento_automation', $field_definitions[$field_name]);
  }

  return 'Added insurance request fields to constancia records.';
}

/**
 * Adds the insured merchandise description field.
 */
function aseguramiento_automation_update_11003(): string {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($definition_update_manager->getFieldStorageDefinition('mercancia_asegurada', 'aseguramiento_constancia')) {
    return 'The Mercancía asegurada field already exists.';
  }

  $entity_type = \Drupal::entityTypeManager()->getDefinition('aseguramiento_constancia');
  $field_definitions = ConstanciaEntity::baseFieldDefinitions($entity_type);
  $definition_update_manager->installFieldStorageDefinition('mercancia_asegurada', 'aseguramiento_constancia', 'aseguramiento_automation', $field_definitions['mercancia_asegurada']);

  return 'Added Mercancía asegurada to constancia records.';
}

/**
 * Adds the operational debug flag to global settings.
 */
function aseguramiento_automation_update_11004(): string {
  $config = \Drupal::configFactory()->getEditable('aseguramiento_automation.settings');
  if ($config->get('debug_mode') === NULL) {
    $config->set('debug_mode', FALSE)->save();
  }
  return 'Se agregó la opción Modo de depuración a la configuración de aseguramiento.';
}

/**
 * Adds maritime and air general reference fields.
 */
function aseguramiento_automation_update_11005(): string {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('aseguramiento_constancia');
  $field_definitions = ConstanciaEntity::baseFieldDefinitions($entity_type);
  $added = [];
  foreach (['ref_maritimo', 'ref_aereo'] as $field_name) {
    if ($definition_update_manager->getFieldStorageDefinition($field_name, 'aseguramiento_constancia')) {
      continue;
    }
    $definition_update_manager->installFieldStorageDefinition($field_name, 'aseguramiento_constancia', 'aseguramiento_automation', $field_definitions[$field_name]);
    $added[] = $field_name;
  }
  return $added ? 'Se agregaron los campos de referencia marítima y aérea.' : 'Los campos de referencia marítima y aérea ya existían.';
}

/**
 * Adds the batch id that groups constancias from the same inbound email.
 */
function aseguramiento_automation_update_11006(): string {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($definition_update_manager->getFieldStorageDefinition('lote', 'aseguramiento_constancia')) {
    return 'El campo lote ya existía.';
  }
  $entity_type = \Drupal::entityTypeManager()->getDefinition('aseguramiento_constancia');
  $field_definitions = ConstanciaEntity::baseFieldDefinitions($entity_type);
  $definition_update_manager->installFieldStorageDefinition('lote', 'aseguramiento_constancia', 'aseguramiento_automation', $field_definitions['lote']);
  return 'Se agregó el campo lote para agrupar constancias por correo de origen.';
}

/**
 * Makes the team notification and the batch reply editable in settings.
 */
function aseguramiento_automation_update_11007(): string {
  aseguramiento_automation_ensure_email_templates();
  return 'Se agregaron las plantillas editables del correo al encargado y de la respuesta agrupada.';
}

/**
 * Seeds the editable email templates without overwriting edited ones.
 */
function aseguramiento_automation_ensure_email_templates(): void {
  $config = \Drupal::configFactory()->getEditable('aseguramiento_automation.settings');
  foreach (EmailTemplateDefaults::settings() as $key => $default) {
    if (trim((string) $config->get($key)) === '') {
      $config->set($key, $default);
    }
  }
  $config->save();
}

/**
 * Lets the gestor role confirm actions without Honeypot's time limit.
 */
function aseguramiento_automation_update_11008(): string {
  aseguramiento_automation_ensure_gestor_role();
  return 'El rol Gestor Aseguramiento ya puede confirmar acciones sin la espera de Honeypot.';
}

/**
 * Ensures the operational manager role exists with dashboard permissions.
 */
function aseguramiento_automation_ensure_gestor_role(): void {
  $role = Role::load('gestor_aseguramiento');
  if (!$role) {
    $role = Role::create([
      'id' => 'gestor_aseguramiento',
      'label' => 'Gestor Aseguramiento',
    ]);
  }

  foreach (aseguramiento_automation_gestor_permissions() as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
}

/**
 * Returns default permissions for the Gestor Aseguramiento role.
 */
function aseguramiento_automation_gestor_permissions(): array {
  $permissions = [
    'access administration pages',
    'view aseguramiento dashboard',
    'view aseguramiento constancia',
    'export aseguramiento data',
    'reprocess aseguramiento constancia',
  ];
  // Honeypot rejects forms sent in under 5 seconds; staff confirming an
  // action quickly is not a bot (administrators already bypass it).
  if (\Drupal::moduleHandler()->moduleExists('honeypot')) {
    $permissions[] = 'bypass honeypot protection';
  }
  return $permissions;
}

/**
 * Returns insurance request field names added by update hooks.
 */
function aseguramiento_automation_solicitud_field_names(): array {
  return array_merge(
    array_keys(ConstanciaEntity::solicitudStringFields()),
    array_keys(ConstanciaEntity::solicitudLongTextFields()),
    array_keys(ConstanciaEntity::solicitudDateFields()),
    array_keys(ConstanciaEntity::solicitudAmountFields()),
    [
      'mercancia_estado',
      'moneda',
      'acepta_informacion_veridica',
    ],
  );
}
